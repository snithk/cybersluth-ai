# Analyzer Configuration
ANALYZER_MODE=batch  # 'batch' or 'realtime'
LOG_LEVEL=INFO      # DEBUG, INFO, WARNING, ERROR, CRITICAL

# Storage Settings
STORAGE_PATH=data
MAX_FILE_SIZE=104857600  # 100MB in bytes

# Scan Intervals (in seconds)
NETWORK_SCAN_INTERVAL=60
LOG_SCAN_INTERVAL=300
ARTIFACT_SCAN_INTERVAL=3600

# Machine Learning Settings
CONFIDENCE_THRESHOLD=0.75

# API Keys (Replace with actual keys)
THREAT_INTEL_API_KEY=your_threat_intel_api_key
MALWARE_DB_API_KEY=your_malware_db_api_key

# External Service URLs (Replace with actual URLs)
THREAT_INTEL_URL=https://api.threatintel.example.com/v1
MALWARE_DB_URL=https://api.malware-db.example.com/v1

# Reporting Settings
REPORT_FORMAT=html,json
MAX_REPORTS=100
REPORT_CLEANUP_AGE=2592000  # 30 days in seconds 